# =====================================================================
# .env.example
# Copiá este archivo como ".env" (en la raíz del proyecto) y completalo.
# El ".env" real NO se sube a git (agregalo al .gitignore).
# El prefijo NG_APP_ es obligatorio: sin él, Angular no expone la variable.
# =====================================================================

# URL base de la API del termómetro (sin barra final)
NG_APP_API_URL=http://localhost:3000

# Solo si usás el refresh-token del axiosClient (opcional).
# Si no hay login en este proyecto, no hace falta.
NG_APP_USERS_URL=http://localhost:3000
